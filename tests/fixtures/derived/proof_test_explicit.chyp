# DERIVED FIXTURE (not an upstream file).
# Derived from Chyp's examples/proof_test.chyp (https://github.com/akissinger/chyp,
# commit 3d28483, by Aleks Kissinger, Apache-2.0; the original has no
# copyright line). Changed by the chyp-rs contributors, 2026, because
# chyp-rs drops these features:
#   - the generator colours ("ffdddd", "ddffdd") are removed;
#   - in theorem foo, `apply simp(ff)` is replaced by explicit `rewrite LHS`
#     steps; in theorem baz, `apply simp(ff)` is replaced by `apply ff`;
#   - this comment and a final newline are added.
# Expected results come from running upstream Chyp on THIS file.
gen f : 1 -> 1
gen g : 1 -> 1
rule ff: f ; f = f
rule gg: g ; g = g

# rewrite-only theorem
rewrite rwfoo: f ; f ; f
  = f ; f by ff
  = f by ff

# theorem with apply-style proof
theorem foo: f ; f; f ; f ; g = f ; g ; g
proof
  rewrite LHS
    = f ; f ; f ; g by ff
    = f ; f ; g by ff
    = f ; g by ff
  apply rule(-gg)
qed

# theorem with rewrite-style proof
theorem bar: f ; f; f = f
proof
  rewrite LHS
    = f ; f by ff
    = RHS by ff
qed

# theorem with mixed proof
theorem baz: f ; f ; f; f = f
proof
  rewrite LHS
    = f ; f ; f by ff
    = f ; f by ff
  apply ff
qed
