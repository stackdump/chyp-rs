# ORIGINAL FIXTURE (chyp-rs contributors, 2026; not derived from any Chyp file):
# upstream Chyp (3d28483) raises KeyError while checking this
# file, because a theorem's rule is recorded in `rule_sequence` but never in
# `rules`. chyp-rs reports "Rule t1 not defined." on the step instead.
gen f : 1 -> 1
rule ff : f ; f = f
theorem t1 : f ; f ; f = f
proof
  rewrite LHS
    = f ; f by ff
    = RHS by ff
qed
rewrite use_thm : f ; f ; f = f by t1
rewrite after : f ; f = f by ff
