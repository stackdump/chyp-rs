# ORIGINAL FIXTURE (chyp-rs contributors, 2026; not derived from any Chyp file):
# tactic arguments still open at the end of the file. Upstream reports the
# line where the unfinished argument starts.
gen f : 1 -> 1
rule ff : f ; f = f
rewrite r : f ; f
  = f by rule(ff

